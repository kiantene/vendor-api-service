<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true">
	<springProperty scope="context" name="springProfile" source="spring.profiles.active" />
	<springProperty scope="context" name="log.charset" source=" log.charset" defaultValue="UTF-8" />

	<appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
		<encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
			<pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
			<charset>${log.charset}</charset>
		</encoder>
	</appender>

	<appender name="STDOUT-DEV" class="ch.qos.logback.core.ConsoleAppender">
		<encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
			<pattern>%d{HH:mm:ss.SSS} [%thread] %highlight(%-5level) %green(%logger{36}) - %msg%n</pattern>
			<charset>${log.charset}</charset>
		</encoder>
	</appender>

	<springProfile name="dev">
		<root level="info">
			<appender-ref ref="STDOUT-DEV" />
		</root>
	</springProfile>

	<springProfile name="!dev">
		<root level="info">
			<appender-ref ref="STDOUT" />
		</root>
	</springProfile>
</configuration>
