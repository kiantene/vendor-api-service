<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<conversionRule conversionWord="clr" converterClass="org.springframework.boot.logging.logback.ColorConverter" />
	<conversionRule conversionWord="wex" converterClass="org.springframework.boot.logging.logback.WhitespaceThrowableProxyConverter" />

	<springProperty scope="context" name="appVersion" source="version" defaultValue="0.0.0" />
	<springProperty scope="context" name="stdoutEnabled" source="stdout.enabled" defaultValue="false" />
	<springProperty scope="context" name="appName" source="spring.application.name" defaultValue="application" />

	<property name="LOG_PATH" value="${LOG_PATH:-/tmp/logs}" />
	<property name="LOG_FILE_NAME" value="${LOG_PATH}/${appName}" />
	<!-- Rotate daily and keep logs for {} days -->
	<property name="MAX_HISTORY" value="${LOG_MAX_HISTORY:-30}" />
	<!-- each archived file's size will be max {}MB -->
	<property name="MAX_FILE_SIZE" value="${LOG_MAX_FILE_SIZE:-500MB}" />
	<!-- total size of all archive files, if total size > {}GB, it will delete old archived file -->
	<property name="TOTAL_SIZE_CAP" value="${LOG_TOTAL_SIZE_CAP:-17GB}" />

	<appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
		<encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
			<pattern>%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg %X%n</pattern>
		</encoder>
	</appender>

	<appender name="STDOUT-DEV" class="ch.qos.logback.core.ConsoleAppender">
		<encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
			<pattern>%clr(%d{HH:mm:ss.SSS}){faint} %clr(${PID:- }){magenta} %clr([%15.15t]){faint} %clr(%5p) %clr(%-37.37logger{36}){cyan} %clr(-){faint} %msg %X%n</pattern>
		</encoder>
	</appender>

	<!-- JSON Appender for Filebeat -->
	<appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${LOG_FILE_NAME}.jsonl</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<fileNamePattern>${LOG_PATH}/${LOG_FILE_NAME}.%d{yyyy-MM-dd}.%i.jsonl</fileNamePattern>
			<maxHistory>${MAX_HISTORY}</maxHistory>
			<maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
			<totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
		</rollingPolicy>
		<encoder class="net.logstash.logback.encoder.LogstashEncoder">
			<fieldNames class="net.logstash.logback.fieldnames.ShortenedFieldNames"/>
			<includeContext>false</includeContext>
			<customFields>{"hostName":"${hostName:-unknown}", "appVersion":"${appVersion:-unknown}"}</customFields>
			<shortenedLoggerNameLength>36</shortenedLoggerNameLength>
			<writeVersionAsInteger>true</writeVersionAsInteger>
			<version>1</version>
		</encoder>
	</appender>

	<springProfile name="dev">
		<root level="info">
			<appender-ref ref="STDOUT-DEV" />
		</root>
	</springProfile>

	<springProfile name="!dev">
		<root level="info">
			<appender-ref ref="JSON_FILE" />
		</root>
	</springProfile>

	<root level="info">
		<if condition='("${stdoutEnabled}" == "true")'>
			<then>
				<appender-ref ref="STDOUT" />
			</then>
		</if>
	</root>
</configuration>
