			<url>http://223.25.67.48/api/v4/projects/19/packages/maven</url>
		</repository>
		<snapshotRepository>
			<id>gitlab-maven</id>
			<url>http://223.25.67.48/api/v4/projects/19/packages/maven</url>
		</snapshotRepository>
